{
  "name": "@vamp08/agenttrace",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.1",
  "description": "Live, explained view of a Claude Code session: what went in, what came out, and why.",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "claude",
    "coding-agent",
    "ai-agents",
    "transcript",
    "session-viewer",
    "diff",
    "developer-tools",
    "local-first"
  ],
  "author": "Pratham Rangunwala",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VamP08/AgentTrace.git"
  },
  "homepage": "https://github.com/VamP08/AgentTrace#readme",
  "bugs": "https://github.com/VamP08/AgentTrace/issues",
  "type": "module",
  "bin": {
    "agenttrace": "bin/agenttrace.mjs"
  },
  "files": [
    "bin/",
    "server/dist/",
    "server/package.json",
    "shared/dist/",
    "shared/package.json",
    "web/dist/",
    "hooks/",
    "skill/",
    "scripts/demo.mjs",
    "scripts/demo/"
  ],
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces",
    "start": "node bin/agenttrace.mjs",
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc -b && tsc --noEmit -p web",
    "prepack": "npm run build",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
